# Copia este archivo como .env.local y rellena los valores.
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_, y es a propósito: todo esto se
# lee solo en el servidor. Con NEXT_PUBLIC_ acabaría en el JavaScript que
# descarga el navegador, y entonces daría igual el PIN.

# Supabase → Project Settings → API
SUPABASE_URL=https://tuproyecto.supabase.co

# La clave `service_role`, no la `anon`. Se salta RLS, que es justo lo que hace
# falta aquí: las tablas están cerradas y el servidor es el único que entra.
SUPABASE_SERVICE_ROLE_KEY=

# Firma la cookie de sesión. Genéralo con: openssl rand -base64 32
# Si cambia, ambos tienen que volver a entrar.
APP_SECRET=

# El PIN de cada uno.
PIN_ABRAHAM=
PIN_ISABEL=

# Notificaciones push. Genéralas con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY no es secreta —el navegador la necesita para suscribirse—
# pero igual se lee solo en el servidor y se manda al cliente por props, no
# por NEXT_PUBLIC_: así queda un único lugar (ajustes/page.tsx) que decide
# qué llega al navegador, en vez de un env var que cualquier import arrastra.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el estándar VAPID; no se usa para nada más.
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# Autentica al cron de Vercel (ver vercel.json) para que nadie más pueda
# llamar a /api/cron/* y disparar avisos a mano. Genéralo con:
# openssl rand -hex 32
CRON_SECRET=
